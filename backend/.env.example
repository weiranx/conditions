# Backend runtime
NODE_ENV=production
PORT=3001
# Owner-only admin overrides for the allowlisted runtime settings are stored in
# backend/data/runtime-env.json locally and /app/data/runtime-env.json in Docker.
# Set this only when that persistent file should live somewhere else.
# RUNTIME_ENV_FILE=

# Comma-separated list of allowed browser origins in production.
# Example: https://summitsafe.example.com,https://admin.example.com
CORS_ORIGIN=

# External request behavior
REQUEST_TIMEOUT_MS=9000
AVALANCHE_MAP_LAYER_TTL_MS=600000
SNOTEL_STATION_CACHE_TTL_MS=43200000

# API rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# PostgreSQL is initialized on the VPS by scripts/deploy-postgres.sh. The script
# writes these values to /opt/summitsafe/.env; do not commit production values.
# POSTGRES_DB=summitsafe
# POSTGRES_USER=summitsafe_app
# POSTGRES_PASSWORD=
# DATABASE_URL=postgresql://summitsafe_app:password@postgres:5432/summitsafe
# Set DATABASE_SSL=require for managed PostgreSQL. Keep it unset for the private
# PostgreSQL container in docker-compose.yml.
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=3000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Password-account sessions. Sessions are stored as hashed opaque tokens in
# PostgreSQL and sent to browsers in secure HTTP-only cookies.
ACCOUNT_SESSION_DAYS=30

# Google Identity Services web client ID. Create an OAuth 2.0 Web application
# client and add the frontend origins (for example http://localhost:5173 and
# https://conditions.example.com) under Authorized JavaScript origins.
# The client ID is public; the backend serves it to the account page and verifies
# every returned ID token before creating a first-party session.
GOOGLE_CLIENT_ID=

# Transactional account email through Resend. All three values are required to
# send verification and password-reset links. APP_BASE_URL is the public web
# origin that hosts /account; never expose RESEND_API_KEY to the frontend.
RESEND_API_KEY=
EMAIL_FROM="Backcountry Conditions <accounts@mail.example.com>"
APP_BASE_URL=https://conditions.example.com

# Independent production health monitor. It polls the readiness endpoint every
# five minutes, emails immediately on an unhealthy transition, repeats the alert
# every six hours while the incident remains open, and emails again on recovery.
# The default recipient is the owner account. Override the URL with the public
# API health endpoint if the monitor should also cover nginx/TLS/DNS.
HEALTH_ALERT_EMAIL=weiranxiong@gmail.com
HEALTH_MONITOR_URL=http://backend:3001/healthz
HEALTH_MONITOR_INTERVAL_SECONDS=300
HEALTH_MONITOR_TIMEOUT_SECONDS=10
HEALTH_MONITOR_MAX_RESPONSE_AGE_SECONDS=120
HEALTH_ALERT_REMINDER_SECONDS=21600
# Retains seven days at the default five-minute interval.
HEALTH_MONITOR_HISTORY_LIMIT=2016

# Provider-reported input and output tokens allowed per Free account each UTC
# month. Premium accounts are unlimited.
AI_FREE_MONTHLY_TOKEN_LIMIT=250000

# Successfully generated reports allowed per Free account each UTC month.
FREE_MONTHLY_USAGE_LIMIT=50
# Legacy report-limit deployments can use this as a fallback.
# REPORT_FREE_MONTHLY_LIMIT=50

# Hourly Objective Watch checker. Generate with: openssl rand -hex 32
# The deploy script installs the host cron only when this value is present.
OBJECTIVE_WATCH_CRON_SECRET=
OBJECTIVE_WATCH_CONCURRENCY=4
OBJECTIVE_WATCH_BATCH_SIZE=100

# Successful multi-day forecast comparisons allowed per Free account each UTC
# month, plus the total guest allowance for one browser identity. Premium
# accounts are unlimited.
FREE_MONTHLY_MULTI_DAY_LIMIT=10
GUEST_MULTI_DAY_LIMIT=3

# Debug avalanche pipeline logs
DEBUG_AVY=false

# Preferred AI provider: openai or anthropic. If its request fails, the backend
# retries once through the other provider when that provider's key is configured.
AI_PROVIDER=openai
# Startup fallback used only when no PostgreSQL admin setting exists.
AI_ENABLED=true
# Optional legacy import source. PostgreSQL is the live settings store.
AI_SETTINGS_FILE=
AI_PRIMARY_TIMEOUT_MS=28000
AI_FAST_TIMEOUT_MS=8000

# OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_FAST_MODEL=gpt-5.6-luna

# Anthropic configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# National Park Service API key (free: https://www.nps.gov/subjects/developer/get-started.htm)
# Enables the "Access & Closures" sub-section of the Local Conditions card
# (nearest national-park alerts/closures). Leave blank to disable; the rest of
# the report works without it.
NPS_API_KEY=

# EPA AirNow observations (free account: https://docs.airnowapi.org/account/request/)
AIRNOW_API_KEY=

# Optional NASA FIRMS active-fire detections. WFIGS perimeters work without it.
# Request a MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/area/
NASA_FIRMS_MAP_KEY=

# Copernicus Data Space Ecosystem OAuth client (free account: https://dataspace.copernicus.eu/)
# Create an OAuth client under Dashboard > User Settings > OAuth clients.
# Enables the "Satellite (Sentinel-2)" map basemap. Leave blank to disable;
# the map falls back to the terrain/street basemaps.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
