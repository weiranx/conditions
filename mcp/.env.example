# Public reports work without a Conditions account session.
CONDITIONS_API_URL=https://apivps.conditions.weiranxiong.com
# Optional: existing bc_session value, never an account password. Expires normally.
CONDITIONS_SESSION=

MCP_HOST=127.0.0.1
PORT=8104
MCP_PUBLIC_URL=http://127.0.0.1:8104
# Generate locally with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Optional OAuth for ChatGPT. Set all four, with separate random secrets.
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_CLIENT_SECRET=
MCP_OWNER_PASSWORD=
# Comma-separated EXACT callback URLs supplied by your MCP client; no wildcards.
MCP_OAUTH_REDIRECT_URIS=
