{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "description": "Backcountry Conditions frontend client",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build && node scripts/create-worker.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:mock": "VITE_MOCK_API=true vite --host 127.0.0.1",
    "test:mock": "node --test dev/mock-api.test.mjs",
    "test:ui": "node scripts/run-ui-tests.mjs",
    "test:field": "node scripts/run-ui-tests.mjs",
    "test:history": "node scripts/run-ui-tests.mjs report-history",
    "test:admin": "node scripts/run-ui-tests.mjs admin"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@ai-sdk/react": "^3.0.226",
    "@types/leaflet": "^1.9.21",
    "ai": "^6.0.224",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.574.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "recharts": "^3.7.0",
    "streamdown": "^2.5.0",
    "tz-lookup": "6.1.25"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/tz-lookup": "6.1.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
